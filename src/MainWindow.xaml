<Window x:Class="WinMigrationCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMigrationCleaner — 硬件迁移残留清理" Height="740" Width="1200"
        MinHeight="620" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}" FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="MetricNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Chip}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListViewBase" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                                        </Trigger>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.RowAlt}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- [Sidebar] -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,26,16,6">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4D7FFF" Offset="0"/>
                                    <GradientStop Color="#7A5CFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="W" FontSize="19" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinMigration" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="Cleaner" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="硬件迁移残留清理" FontSize="11" Foreground="{DynamicResource Brush.SubText}" Margin="2,12,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,16">
                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="11" Padding="12,11">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{DynamicResource Brush.Warn}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AdminText" Text="未提权：可扫描，清理需提权" FontSize="10.8"
                                           Foreground="{DynamicResource Brush.SubText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnElevate" Style="{StaticResource BtnGhost}" Content="以管理员身份重启" FontSize="12"
                                    Margin="0,10,0,0" Padding="8,6" Click="BtnElevate_Click"/>
                            <Button x:Name="BtnToggleTheme" Style="{StaticResource BtnGhost}" Content="切换浅色主题" FontSize="12"
                                    Margin="0,8,0,0" Padding="8,6" Click="BtnToggleTheme_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <Button x:Name="NavDash" Style="{StaticResource NavButton}" Tag="active" Click="Nav_Click" Content="仪表盘"/>
                    <Button x:Name="NavDevices" Style="{StaticResource NavButton}" Click="Nav_Click" Content="幽灵设备"/>
                    <Button x:Name="NavServices" Style="{StaticResource NavButton}" Click="Nav_Click" Content="系统服务"/>
                    <Button x:Name="NavDrivers" Style="{StaticResource NavButton}" Click="Nav_Click" Content="驱动包"/>
                    <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Click="Nav_Click" Content="关于"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- [Content] -->
        <Grid Grid.Column="1" Margin="26,22,26,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="168"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- [Page Dashboard] -->
            <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="仪表盘"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                                       Text="检测从旧电脑迁移系统后遗留的幽灵设备、厂商服务和过期驱动包"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="BtnScanAll" Style="{StaticResource BtnPrimary}" Content="开始全面扫描" Click="BtnScanAll_Click"/>
                            <Button x:Name="BtnExportReport" Style="{StaticResource BtnGhost}" Content="导出报告" Margin="10,0,0,0" Click="BtnExportReport_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- metric tiles -->
                    <UniformGrid Columns="3" Margin="0,22,0,0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0" Padding="18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource MetricIcon}" Background="{DynamicResource Brush.AccentSoft}">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Accent}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="幽灵设备残留（可清理）" FontSize="12.5" Foreground="{DynamicResource Brush.SubText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MetricDevices" Style="{StaticResource MetricNum}" Text="—"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" 项" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MetricDevicesSub" Style="{StaticResource Sub}" Text="未扫描"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0" Padding="18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource MetricIcon}" Background="{DynamicResource Brush.WarnSoft}">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Warn}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="旧厂商残留服务" FontSize="12.5" Foreground="{DynamicResource Brush.SubText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MetricServices" Style="{StaticResource MetricNum}" Text="—"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" 项" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MetricServicesSub" Style="{StaticResource Sub}" Text="未扫描"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="18,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource MetricIcon}" Background="{DynamicResource Brush.GreenSoft}">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Green}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="过期驱动包（DriverStore）" FontSize="12.5" Foreground="{DynamicResource Brush.SubText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MetricDrivers" Style="{StaticResource MetricNum}" Text="—"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" 项" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MetricDriversSub" Style="{StaticResource Sub}" Text="未扫描"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- hardware info list -->
                    <Border Style="{DynamicResource CardBorder}" Margin="0,16,0,20" Padding="18,14">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Sub}" Text="本机硬件"/>
                            <ItemsControl x:Name="InfoList" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Brush.SubText}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                                                       Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="10,0,0,0"
                                                       LineHeight="19"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- [Page Devices] -->
            <Grid x:Name="PageDevices" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="幽灵设备"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                                   Text="列出全部设备：正在工作的标记为「本机所需」，已断开硬件的残留记录标记为「幽灵设备」（可安全移除）。"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnScanDevices" Style="{StaticResource BtnGhost}" Content="扫描" Click="BtnScanDevices_Click"/>
                        <Button x:Name="BtnSelectAllDevices" Style="{StaticResource BtnGhost}" Content="全选 / 取消" Margin="8,0,0,0" Click="BtnSelectAllDevices_Click"/>
                        <Button x:Name="BtnRemoveDevices" Style="{StaticResource BtnDanger}" Content="移除所选" Margin="8,0,0,0" Click="BtnRemoveDevices_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="8">
                    <Grid>
                    <ListView x:Name="ListDevices" Style="{StaticResource ListViewBase}" AlternationCount="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="设备名称" Width="320" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="类别" Width="120" DisplayMemberBinding="{Binding Class}"/>
                                <GridViewColumn Header="状态" Width="96" DisplayMemberBinding="{Binding Status}"/>
                                <GridViewColumn Header="实例 ID" Width="380" DisplayMemberBinding="{Binding InstanceId}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="DevicesEmpty" Text="没有发现幽灵设备 —— 当前硬件的记录都在正常工作"
                               FontSize="13" Foreground="{DynamicResource Brush.SubText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="DevicesSummary" Grid.Row="2" Style="{StaticResource Sub}" Margin="6,10,0,4" Text="尚未扫描。"/>
                <!-- empty-state placeholder for devices page -->

            </Grid>

            <!-- [Page Services] -->
            <Grid x:Name="PageServices" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="系统服务"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                                   Text="检测到来自其它硬件厂商的驱动服务。删除前请确认当前电脑已不需要它们。"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnScanServices" Style="{StaticResource BtnGhost}" Content="扫描" Click="BtnScanServices_Click"/>
                        <Button x:Name="BtnDisableServices" Style="{StaticResource BtnGhost}" Content="禁用所选" Margin="8,0,0,0" Click="BtnDisableServices_Click"/>
                        <Button x:Name="BtnDeleteServices" Style="{StaticResource BtnDanger}" Content="删除所选" Margin="8,0,0,0" Click="BtnDeleteServices_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="8">
                    <ListView x:Name="ListServices" Style="{StaticResource ListViewBase}" AlternationCount="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="服务名" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="显示名" Width="250" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding State}"/>
                                <GridViewColumn Header="启动类型" Width="100" DisplayMemberBinding="{Binding StartMode}"/>
                                <GridViewColumn Header="判定依据" Width="220" DisplayMemberBinding="{Binding Reason}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <TextBlock x:Name="ServicesSummary" Grid.Row="2" Style="{StaticResource Sub}" Margin="6,10,0,4" Text="尚未扫描。"/>
            </Grid>

            <!-- [Page Drivers] -->
            <Grid x:Name="PageDrivers" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="驱动包（DriverStore）"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                                   Text="未被在线设备引用的驱动包。仅「可清理」项允许删除；「软件」属于已安装软件；「保留」为当前平台组件。"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnScanDrivers" Style="{StaticResource BtnGhost}" Content="扫描" Click="BtnScanDrivers_Click"/>
                        <Button x:Name="BtnDeleteDrivers" Style="{StaticResource BtnDanger}" Content="删除所选「可清理」" Margin="8,0,0,0" Click="BtnDeleteDrivers_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="8">
                    <ListView x:Name="ListDrivers" Style="{StaticResource ListViewBase}" AlternationCount="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="发布名" Width="120" DisplayMemberBinding="{Binding PublishedName}"/>
                                <GridViewColumn Header="原始 INF" Width="220" DisplayMemberBinding="{Binding OriginalName}"/>
                                <GridViewColumn Header="提供商" Width="230" DisplayMemberBinding="{Binding Provider}"/>
                                <GridViewColumn Header="版本" Width="170" DisplayMemberBinding="{Binding Version}"/>
                                <GridViewColumn Header="判定" Width="110" DisplayMemberBinding="{Binding Risk}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <TextBlock x:Name="DriversSummary" Grid.Row="2" Style="{StaticResource Sub}" Margin="6,10,0,4" Text="尚未扫描。"/>
            </Grid>

            <!-- [Page About] -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PageTitle}" Text="关于 WinMigrationCleaner"/>
                    <TextBlock Foreground="{DynamicResource Brush.BodyText}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,16,0,0"
                               Text="当你把 Windows 系统从一台电脑迁移到另一台（换主板、换机装老系统、笔记本换台式机），旧硬件会在系统里留下三类残留：幽灵设备记录、厂商驱动服务和 DriverStore 驱动包。本工具把这三类残留的检测与清理整合到一起，并内置多层安全保护：自动保留当前平台的核心驱动套件，识别属于已安装软件的驱动包，并默认以「只报告」方式呈现可清理项，所有删除操作均需显式确认。"/>
                    <TextBlock Foreground="{DynamicResource Brush.BodyText}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"
                               Text="本项目使用 Windows 内置的 WMI 与 pnputil，不含任何第三方二进制。所有破坏性操作均写入活动日志。"/>
                    <Border Style="{StaticResource CardBorder}" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="安全边界" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Foreground="{DynamicResource Brush.SubText}" FontSize="12" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="• 幽灵设备：仅移除 Present=false 的记录，重新插入硬件会自动重装&#10;• 驱动包：仅允许删除标记为「可清理」的项，删除前二次确认&#10;• 服务：仅显示命中厂商关键字的候选，删除前单独确认&#10;• 建议操作前创建系统还原点；删除后重启一次让变更完全生效"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,18,0,20" Text="MIT License · v1.0.0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- [Activity log] -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource Sub}" Text="活动日志（每次操作都有记录）"/>
                        <Button x:Name="BtnClearLog" Style="{StaticResource BtnGhost}" Content="清空" FontSize="11" Padding="9,3"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClearLog_Click"/>
                    </Grid>
                    <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel" Margin="0,4,0,0"
                             FontFamily="Consolas, Microsoft YaHei UI">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource Brush.LogTime}"
                                               FontFamily="Consolas, Microsoft YaHei UI" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message, Mode=OneWay}" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.LogText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Brush.Green}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="err"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- [Progress bar] -->
            <ProgressBar x:Name="MainProgress" Grid.Row="2" Height="6" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Chip}"
                         BorderThickness="0"/>

            <!-- [Status bar] -->
            <Grid Grid.Row="3" Margin="6,6,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" Text="就绪" VerticalAlignment="Center"/>
                <Button x:Name="BtnBusy" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="■ 停止" FontSize="11" Padding="9,3"
                        Visibility="Collapsed" Click="BtnBusy_Click"/>
            </Grid>
        </Grid>
    </Grid>
