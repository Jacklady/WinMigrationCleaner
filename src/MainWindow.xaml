<Window x:Class="WinMigrationCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMigrationCleaner — 硬件迁移残留清理" Height="740" Width="1200"
        MinHeight="620" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}" FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="MetricNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="EmptyIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- clickable sortable column header -->
        <Style x:Key="SortHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Chip}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="arrow" Text=" ↓" Foreground="{DynamicResource Brush.Accent}"
                                           FontSize="11" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="sorted">
                                <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- implicit fallback so headerless columns (checkbox) don't use the default white style -->
        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource SortHeader}"/>
        <Style x:Key="ListViewBase" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                                        </Trigger>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.RowAlt}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- [Sidebar] -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,26,16,6">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4D7FFF" Offset="0"/>
                                    <GradientStop Color="#7A5CFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="W" FontSize="19" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinMigration" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="Cleaner v1.2" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="硬件迁移残留清理" FontSize="11" Foreground="{DynamicResource Brush.SubText}" Margin="2,12,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,16">
                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="11" Padding="12,11">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{DynamicResource Brush.Warn}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AdminText" Text="未提权：可扫描，清理需提权" FontSize="10.8"
                                           Foreground="{DynamicResource Brush.SubText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnElevate" Style="{StaticResource BtnGhost}" Content="以管理员身份重启" FontSize="12"
                                    Margin="0,10,0,0" Padding="8,6" Click="BtnElevate_Click"/>
                            <Button x:Name="BtnToggleTheme" Style="{StaticResource BtnGhost}" Content="切换浅色主题" FontSize="12"
                                    Margin="0,8,0,0" Padding="8,6" Click="BtnToggleTheme_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="快捷键：F5 重扫 · Ctrl+A 全选&#10;Ctrl+F 搜索 · 双击卡片跳转" FontSize="10.5"
                               Foreground="{DynamicResource Brush.SubText}" Margin="4,10,0,0" Opacity="0.8" LineHeight="16"/>
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <Button x:Name="NavDash" Style="{StaticResource NavButton}" Tag="active" Click="Nav_Click" Content="仪表盘"/>
                    <Button x:Name="NavDevices" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <Grid>
                            <TextBlock Text="幽灵设备"/>
                            <Border x:Name="BadgeDevices" Background="{DynamicResource Brush.Danger}" CornerRadius="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,6,0">
                                <TextBlock x:Name="BadgeDevicesText" Style="{StaticResource BadgeText}" Text="0" Margin="7,1.5"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="NavServices" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <Grid>
                            <TextBlock Text="系统服务"/>
                            <Border x:Name="BadgeServices" Background="{DynamicResource Brush.Warn}" CornerRadius="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,6,0">
                                <TextBlock x:Name="BadgeServicesText" Style="{StaticResource BadgeText}" Text="0" Margin="7,1.5"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="NavDrivers" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <Grid>
                            <TextBlock Text="驱动包"/>
                            <Border x:Name="BadgeDrivers" Background="{DynamicResource Brush.Green}" CornerRadius="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,6,0">
                                <TextBlock x:Name="BadgeDriversText" Style="{StaticResource BadgeText}" Text="0" Margin="7,1.5"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Click="Nav_Click" Content="关于"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- [Content] -->
        <Grid Grid.Column="1" Margin="26,22,26,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- [Page Dashboard] -->
            <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="仪表盘"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                                       Text="点击下方卡片可跳转对应清理页，或直接一键清理全部安全项。"/>
                            <TextBlock x:Name="CacheInfoText" Style="{StaticResource Sub}" FontSize="11.5"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="BtnScanAll" Style="{StaticResource BtnPrimary}" Content="重新扫描 (F5)" Click="BtnScanAll_Click"/>
                            <Button x:Name="BtnExportReport" Style="{StaticResource BtnGhost}" Content="导出报告" Margin="10,0,0,0" Click="BtnExportReport_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- metric tiles -->
                    <UniformGrid Columns="3" Margin="0,22,0,0">
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,14,0" Padding="18,16" Tag="devices" MouseLeftButtonUp="MetricCard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource MetricIcon}" Background="{DynamicResource Brush.AccentSoft}">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Accent}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="幽灵设备残留（可清理）" FontSize="12.5" Foreground="{DynamicResource Brush.SubText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MetricDevices" Style="{StaticResource MetricNum}" Text="—"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" 项" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MetricDevicesSub" Style="{StaticResource Sub}" Text="未扫描"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,14,0" Padding="18,16" Tag="services" MouseLeftButtonUp="MetricCard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource MetricIcon}" Background="{DynamicResource Brush.WarnSoft}">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Warn}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="旧厂商残留服务" FontSize="12.5" Foreground="{DynamicResource Brush.SubText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MetricServices" Style="{StaticResource MetricNum}" Text="—"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" 项" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MetricServicesSub" Style="{StaticResource Sub}" Text="未扫描"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Padding="18,16" Tag="drivers" MouseLeftButtonUp="MetricCard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource MetricIcon}" Background="{DynamicResource Brush.GreenSoft}">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Green}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="过期驱动包（DriverStore）" FontSize="12.5" Foreground="{DynamicResource Brush.SubText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MetricDrivers" Style="{StaticResource MetricNum}" Text="—"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" 项" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MetricDriversSub" Style="{StaticResource Sub}" Text="未扫描"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- one-click quick clean -->
                    <Border x:Name="QuickCleanCard" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="18,15"
                            Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="一键清理安全项" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                                <TextBlock x:Name="QuickCleanText" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="扫描完成后这里会汇总可安全清理的内容。"/>
                            </StackPanel>
                            <Button x:Name="BtnQuickClean" Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="一键清理"
                                    VerticalAlignment="Center" Margin="16,0,0,0" Click="BtnQuickClean_Click"/>
                        </Grid>
                    </Border>

                    <!-- hardware info list -->
                    <Border Style="{DynamicResource CardBorder}" Margin="0,16,0,20" Padding="18,14">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Sub}" Text="本机硬件"/>
                            <ItemsControl x:Name="InfoList" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Brush.SubText}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                                                       Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="10,0,0,0"
                                                       LineHeight="19"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- [Page Devices] -->
            <Grid x:Name="PageDevices" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="幽灵设备"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                               Text="列出全部设备：正在工作的标记为「本机所需」，已断开硬件的残留记录标记为「幽灵设备」（可安全移除）。"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchDevices" Style="{StaticResource SearchBox}" Tag="搜索设备名称 / 类别 / 实例 ID…"
                             TextChanged="SearchDevices_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnScanDevices" Style="{StaticResource BtnGhost}" Content="重新扫描" Click="BtnScanDevices_Click"/>
                        <Button x:Name="BtnSelectAllDevices" Style="{StaticResource BtnGhost}" Content="全选 / 取消 (Ctrl+A)" Margin="8,0,0,0" Click="BtnSelectAllDevices_Click"/>
                        <Button x:Name="BtnRemoveDevices" Style="{StaticResource BtnDanger}" Content="移除所选" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnRemoveDevices_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="8">
                    <Grid>
                        <ListView x:Name="ListDevices" Style="{StaticResource ListViewBase}" AlternationCount="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="46">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelect}" Click="DevCheck_Click"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="320">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="Name" Click="DeviceHeader_Click">设备名称</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="120">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="Class" Click="DeviceHeader_Click">类别</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Class}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="110">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="IsGhost" Click="DeviceHeader_Click">状态</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="11.5" Padding="7,2.5" Text="{Binding Status}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGhost}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="380">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="InstanceId" Click="DeviceHeader_Click">实例 ID</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding InstanceId}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.SubText}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel x:Name="DevicesEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EmptyIcon}" Foreground="{DynamicResource Brush.Green}" Text="✓"/>
                            <TextBlock x:Name="DevicesEmptyText" Text="没有发现幽灵设备 —— 当前硬件的记录都在正常工作" FontSize="13"
                                       Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="DevicesSummary" Grid.Row="3" Style="{StaticResource Sub}" Margin="6,10,0,4" Text="正在自动扫描…"/>
            </Grid>

            <!-- [Page Services] -->
            <Grid x:Name="PageServices" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="系统服务"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                               Text="检测到来自其它硬件厂商的驱动服务。建议先「禁用」观察几天，确认无影响后再删除。"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchServices" Style="{StaticResource SearchBox}" Tag="搜索服务名 / 显示名 / 判定依据…"
                             TextChanged="SearchServices_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnScanServices" Style="{StaticResource BtnGhost}" Content="重新扫描" Click="BtnScanServices_Click"/>
                        <Button x:Name="BtnSelectAllServices" Style="{StaticResource BtnGhost}" Content="全选 / 取消 (Ctrl+A)" Margin="8,0,0,0" Click="BtnSelectAllServices_Click"/>
                        <Button x:Name="BtnDisableServices" Style="{StaticResource BtnGhost}" Content="禁用所选" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnDisableServices_Click"/>
                        <Button x:Name="BtnDeleteServices" Style="{StaticResource BtnDanger}" Content="删除所选" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnDeleteServices_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="8">
                    <Grid>
                        <ListView x:Name="ListServices" Style="{StaticResource ListViewBase}" AlternationCount="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="46">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="SvcCheck_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="220">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="Name" Click="ServiceHeader_Click">服务名</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="250">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="DisplayName" Click="ServiceHeader_Click">显示名</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="State" Click="ServiceHeader_Click">状态</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding State}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="100">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="StartMode" Click="ServiceHeader_Click">启动类型</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StartMode}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="220">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="Reason" Click="ServiceHeader_Click">判定依据</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.SubText}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel x:Name="ServicesEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EmptyIcon}" Foreground="{DynamicResource Brush.Green}" Text="✓"/>
                            <TextBlock x:Name="ServicesEmptyText" Text="没有命中厂商关键字的候选服务" FontSize="13" Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="ServicesSummary" Grid.Row="3" Style="{StaticResource Sub}" Margin="6,10,0,4" Text="正在自动扫描…"/>
            </Grid>

            <!-- [Page Drivers] -->
            <Grid x:Name="PageDrivers" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="驱动包（DriverStore）"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,7,0,0"
                               Text="未被在线设备引用的驱动包。仅「可清理」项允许删除；「软件」属于已安装软件；「保留」为当前平台组件。"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchDrivers" Style="{StaticResource SearchBox}" Tag="搜索发布名 / INF / 提供商…"
                             TextChanged="SearchDrivers_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnScanDrivers" Style="{StaticResource BtnGhost}" Content="重新扫描" Click="BtnScanDrivers_Click"/>
                        <Button x:Name="BtnSelectAllDrivers" Style="{StaticResource BtnGhost}" Content="全选「可清理」(Ctrl+A)" Margin="8,0,0,0" Click="BtnSelectAllDrivers_Click"/>
                        <Button x:Name="BtnDeleteDrivers" Style="{StaticResource BtnDanger}" Content="删除所选「可清理」" Margin="8,0,0,0"
                                IsEnabled="False" Click="BtnDeleteDrivers_Click"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="8">
                    <Grid>
                        <ListView x:Name="ListDrivers" Style="{StaticResource ListViewBase}" AlternationCount="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="46">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelect}" Click="DrvCheck_Click"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="120">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="PublishedName" Click="DriverHeader_Click">发布名</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding PublishedName}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="220">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="OriginalName" Click="DriverHeader_Click">原始 INF</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="230">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="Provider" Click="DriverHeader_Click">提供商</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Provider}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="170">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="Version" Click="DriverHeader_Click">版本</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Version}" Foreground="{DynamicResource Brush.SubText}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="110">
                                        <GridViewColumnHeader Style="{StaticResource SortHeader}" Tag="Risk" Click="DriverHeader_Click">判定</GridViewColumnHeader>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="11.5" Padding="7,2.5" Text="{Binding Risk}" TextAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Risk}" Value="可清理">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Green}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Risk}" Value="软件">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel x:Name="DriversEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EmptyIcon}" Foreground="{DynamicResource Brush.Green}" Text="✓"/>
                            <TextBlock x:Name="DriversEmptyText" Text="没有未使用的驱动包" FontSize="13" Foreground="{DynamicResource Brush.SubText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="DriversSummary" Grid.Row="3" Style="{StaticResource Sub}" Margin="6,10,0,4" Text="正在自动扫描…"/>
            </Grid>

            <!-- [Page About] -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PageTitle}" Text="关于 WinMigrationCleaner"/>
                    <TextBlock Foreground="{DynamicResource Brush.BodyText}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,16,0,0"
                               Text="当你把 Windows 系统从一台电脑迁移到另一台（换主板、换机装老系统、笔记本换台式机），旧硬件会在系统里留下三类残留：幽灵设备记录、厂商驱动服务和 DriverStore 驱动包。本工具把这三类残留的检测与清理整合到一起，并内置多层安全保护：自动保留当前平台的核心驱动套件，识别属于已安装软件的驱动包，并默认以「只报告」方式呈现可清理项，所有删除操作均需显式确认。"/>
                    <Border Style="{StaticResource CardBorder}" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="v1.1 / v1.2 改进" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Foreground="{DynamicResource Brush.SubText}" FontSize="12" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="• 启动即自动扫描，无需手动点击&#10;• 仪表盘新增「一键清理安全项」：幽灵设备 + 可清理驱动包一次完成&#10;• 各列表页支持实时搜索过滤、点击列头排序、Ctrl+A 全选、Ctrl+F 搜索&#10;• 幽灵设备扫描后默认勾选，操作按钮实时显示已选数量、未选中时自动禁用&#10;• 活动日志可折叠，侧边导航实时显示各类残留计数&#10;• 扫描结果本地缓存（7 天内有效）：下次启动直接使用上次结果，F5 随时刷新&#10;• 清理失败时逐条显示原因与解决建议"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="安全边界" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Foreground="{DynamicResource Brush.SubText}" FontSize="12" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="• 幽灵设备：仅移除 Present=false 的记录，重新插入硬件会自动重装&#10;• 驱动包：仅允许删除标记为「可清理」的项，删除前二次确认&#10;• 服务：仅显示命中厂商关键字的候选，删除前单独确认&#10;• 建议操作前创建系统还原点；删除后重启一次让变更完全生效"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,18,0,20" Text="MIT License · v1.2.0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- [Activity log] -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="14,9">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Sub}" Text="活动日志（每次操作都有记录）" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearLog" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="清空" FontSize="11" Padding="9,3"
                                VerticalAlignment="Top" Click="BtnClearLog_Click"/>
                        <Button x:Name="BtnToggleLog" Grid.Column="2" Style="{StaticResource BtnGhost}" Content="收起 ▾" FontSize="11" Padding="9,3"
                                Margin="8,0,0,0" VerticalAlignment="Top" Click="BtnToggleLog_Click"/>
                    </Grid>
                    <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Height="118"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel" Margin="0,6,0,0"
                             FontFamily="Consolas, Microsoft YaHei UI">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource Brush.LogTime}"
                                               FontFamily="Consolas, Microsoft YaHei UI" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message, Mode=OneWay}" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.LogText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource Brush.Green}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="err"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- [Progress bar] -->
            <ProgressBar x:Name="MainProgress" Grid.Row="2" Height="6" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Chip}"
                         BorderThickness="0"/>

            <!-- [Status bar] -->
            <Grid Grid.Row="3" Margin="6,6,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" Text="正在自动扫描…" VerticalAlignment="Center"/>
                <Button x:Name="BtnBusy" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="■ 停止" FontSize="11" Padding="9,3"
                        Visibility="Collapsed" Click="BtnBusy_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
