<Application x:Class="WinMigrationCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Palette: deep slate + electric blue accent ===== -->
            <SolidColorBrush x:Key="Brush.Bg" Color="#0B0E14"/>
            <SolidColorBrush x:Key="Brush.Panel" Color="#10141C"/>
            <SolidColorBrush x:Key="Brush.Card" Color="#151A24"/>
            <SolidColorBrush x:Key="Brush.CardHover" Color="#1B2230"/>
            <SolidColorBrush x:Key="Brush.Border" Color="#232B3A"/>
            <SolidColorBrush x:Key="Brush.Text" Color="#E8ECF4"/>
            <SolidColorBrush x:Key="Brush.SubText" Color="#8C97AB"/>
            <SolidColorBrush x:Key="Brush.Accent" Color="#4D7FFF"/>
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#6B94FF"/>
            <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A2745"/>
            <SolidColorBrush x:Key="Brush.Green" Color="#34D399"/>
            <SolidColorBrush x:Key="Brush.GreenSoft" Color="#12301F"/>
            <SolidColorBrush x:Key="Brush.Warn" Color="#F5A623"/>
            <SolidColorBrush x:Key="Brush.WarnSoft" Color="#33270F"/>
            <SolidColorBrush x:Key="Brush.Danger" Color="#F87171"/>
            <SolidColorBrush x:Key="Brush.DangerHover" Color="#FB8A8A"/>
            <SolidColorBrush x:Key="Brush.DangerSoft" Color="#391A1C"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            </Style>

            <!-- ===== Sidebar nav ===== -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.SubText}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="10,3"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1A2130"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="active">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                    <Setter Property="Foreground" Value="#B9CCFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Buttons ===== -->
            <Style x:Key="BtnPrimary" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnGhost" TargetType="Button">
                <Setter Property="Background" Value="#1A2130"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#232C3E"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#35415A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <!-- ===== Metric tile ===== -->
            <Style x:Key="MetricIcon" TargetType="Border">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
