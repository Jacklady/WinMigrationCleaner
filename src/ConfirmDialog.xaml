<Window x:Class="WinMigrationCleaner.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Width="460" WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="#1D2129" BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="14" Margin="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="MessageText" FontSize="13" Foreground="#B8BFCE" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="DetailText" FontSize="12" Foreground="#8B93A7" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnNo" Style="{StaticResource BtnGhost}" Content="取消" Click="BtnNo_Click"/>
                <Button x:Name="BtnYes" Grid.Column="2" Style="{StaticResource BtnDanger}" Content="确认删除" Click="BtnYes_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
